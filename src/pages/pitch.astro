---
/**
 * Propuesta para Andreani: portada, carta, antes/después, oportunidades, métricas medidas con Lighthouse,
 * el cotizador en seis pasos, ideas de diseño, celular, implementación, recorrido y contacto.
 */
import QRCode from 'qrcode'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Lines from '../components/Lines.astro'
import Emblem from '../components/Emblem.astro'
import M from '../data/pitch-metrics.json'
import { url, stats, AUTHOR } from '../lib/site'

const siteUrl = new URL(url('/'), Astro.site).href
const qr = await QRCode.toString(siteUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#ffffff', light: '#0000' } })

type Metric = (typeof M)['home']['old']
type Row = { k: string; hint: string; old: number; neu: number; unit: string; dec: number; up?: boolean; max?: number }
const rows = (o: Metric, n: Metric): Row[] => [
  { k: 'Rendimiento', hint: 'Puntaje de Lighthouse, de 0 a 100', old: o.perf, neu: n.perf, unit: '', dec: 0, up: true, max: 100 },
  { k: 'Contenido principal visible', hint: 'LCP: cuándo aparece lo más importante', old: o.lcp / 1000, neu: n.lcp / 1000, unit: ' s', dec: 1 },
  { k: 'Tiempo bloqueado', hint: 'TBT: la página no responde al toque', old: o.tbt, neu: n.tbt, unit: ' ms', dec: 0 },
  { k: 'Saltos de diseño', hint: 'CLS: cuánto se mueve la página mientras carga', old: o.cls, neu: n.cls, unit: '', dec: 2 },
  { k: 'Peso total', hint: 'Todo lo que descarga el celular', old: o.bytes / 1e6, neu: n.bytes / 1e6, unit: ' MB', dec: 2 },
  { k: 'JavaScript', hint: 'Código que el teléfono tiene que ejecutar', old: o.js / 1000, neu: n.js / 1000, unit: ' KB', dec: 0 },
  { k: 'Solicitudes', hint: 'Archivos que pide la página', old: o.reqs, neu: n.reqs, unit: '', dec: 0 },
  { k: 'Accesibilidad', hint: 'Contraste, títulos, etiquetas, foco', old: o.a11y, neu: n.a11y, unit: '', dec: 0, up: true, max: 100 },
  { k: 'Buenas prácticas', hint: 'Seguridad, consola, imágenes', old: o.bp, neu: n.bp, unit: '', dec: 0, up: true, max: 100 },
]
const fmt = (v: number, d = 0) => v.toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d })
const round = (v: number, d: number) => Math.round(v * 10 ** d) / 10 ** d
const change = (r: Row) => {
  if (r.up) return `+${fmt(r.neu - r.old)} pts`
  if (!r.old) return '='
  const pct = Math.round((1 - r.neu / r.old) * 100)
  return pct > 0 ? `−${fmt(pct)} %` : `+${fmt(-pct)} %`
}
const pages = [
  { id: 'home', label: 'Inicio', rows: rows(M.home.old, M.home.new), o: M.home.old, n: M.home.new },
  { id: 'suc', label: 'Buscar sucursal', rows: rows(M.suc.old, M.suc.new), o: M.suc.old, n: M.suc.new },
]
const measured = new Date(M.measured + 'T12:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })
const speedup = (M.home.old.lcp / M.home.new.lcp).toLocaleString('es-AR', { maximumFractionDigits: 0 })
const lighter = Math.round(M.home.old.bytes / M.home.new.bytes)

const chapters = [
  ['01', 'Carta', '#carta'],
  ['02', 'Antes y después', '#antes-despues'],
  ['03', 'Dónde hay margen', '#margen'],
  ['04', 'Los números', '#numeros'],
  ['05', 'El cotizador', '#cotizador'],
  ['06', 'Ideas de diseño', '#ideas'],
  ['07', 'Cómo se implementa', '#integracion'],
  ['08', 'Recorrido', '#recorrido'],
]
const pasos = [
  ['Bultos', 'Paquetería, sobre, vinos o pallets. Filas con cantidad, kilos y medidas, o una planilla CSV con hasta 50 bultos.'],
  ['Origen', 'Las 3 sucursales reales más cercanas, con distancia y horario, o el retiro a domicilio con fecha.'],
  ['Destino', 'Entrega a domicilio o retiro en sucursal, con la red real de puntos de atención.'],
  ['Contacto', 'Email y celular para los avisos, y WhatsApp para el destinatario.'],
  ['Pago', 'Resumen claro con el total. En el sitio real, acá se abre el checkout.'],
  ['Etiqueta', 'Se imprime en pantalla con número de envío, código de clasificación y un QR que abre su seguimiento.'],
]
const ideas = [
  { i: 'truck', t: 'Una carga de apertura', d: 'El camión con la librea real entra, se llenan las cajas, la cámara entra en una y las solapas se abren sobre el inicio. Corre en CSS y se muestra una sola vez por sesión.' },
  { i: 'bolt', t: 'Precios en segundos', d: 'El inicio y la página de envíos llevan al cotizador. Las rutas frecuentes cotizan con un toque y los precios se recalculan en vivo.' },
  { i: 'pin', t: 'La red, a la vista', d: `Un mapa con ${291} puntos reales de la API pública, hubs que laten y rutas que salen de Pacheco. Buscador por localidad, CP o cercanía.` },
  { i: 'scan', t: 'Seguimiento que se entiende', d: 'Etapas, eventos y el camión avanzando sobre el mapa. El QR de cada etiqueta abre ese envío.' },
  { i: 'boxes', t: 'Empresas con peso propio', d: `Los ${stats.empresas.toLocaleString('es-AR')} clientes corporativos y la planta de Pacheco (${stats.porHora.toLocaleString('es-AR')} paquetes por hora) cuentan su historia con video y un formulario directo.` },
  { i: 'spark', t: 'La marca en movimiento', d: 'Archivo expandida e itálica como el logo, el rojo Andreani, cinta de embalar y etiquetas. Videos propios en bucle que solo cargan cuando se ven.' },
]
const tour = [
  ['Inicio', '/', 'Carga de apertura, hero en video, recorrido horizontal, mapa de la red y cotizador.'],
  ['Enviar', '/enviar/', 'El cotizador completo, modos de despacho, catálogo y preguntas frecuentes.'],
  ['Seguir envío', '/seguimiento/?n=360002614871055', 'Etapas, eventos y el camión en el mapa. Probá con el número de ejemplo.'],
  ['Sucursales', '/sucursales/', '291 puntos reales con filtros, cercanía y cómo llegar.'],
  ['Empresas', '/empresas/', 'Servicios B2B con video, la planta de Pacheco e industrias.'],
  ['Nosotros', '/nosotros/', 'De Casilda en 1945 a los 80 años, Brasil y sustentabilidad.'],
  ['Página 404', '/esta-pagina-no-existe/', 'Hasta el error tiene su caja.'],
]
const mail = `mailto:${AUTHOR.email}?subject=${encodeURIComponent('Rediseño web Andreani')}`
---
<Base title="Propuesta de rediseño" description="Propuesta de rediseño conceptual para Andreani: antes y después, métricas medidas, el cotizador en seis pasos e implementación.">
  <!-- ============ PORTADA ============ -->
  <section class="ph t-dark">
    <div class="wrap">
      <div class="ph__grid">
        <div>
          <p class="kick">Propuesta de rediseño · Concepto independiente</p>
          <Lines as="h1" class="dsp d1 ph__t" text="Todo llega.|*Más rápido.*" />
          <p class="lede" data-rv>Un rediseño completo de andreani.com pensado para vender más envíos: cotizar sin cuenta, reservar en seis pasos y seguir el paquete desde un QR. Construido con datos reales de la red.</p>
          <div class="ph__cta" data-rv>
            <a class="btn" href={url('/')}>Ver el sitio <Icon name="arrow" /></a>
            <a class="btn btn--ghost" href={url('/enviar/#cotizador')}>Probar el cotizador <Icon name="arrow" /></a>
          </div>
        </div>
        <nav class="toc" aria-label="Capítulos" data-rv>
          <p class="mono toc__h">Contenido</p>
          <ol>
            {chapters.map(([n, t, h]) => <li><a href={h}><span class="mono">{n}</span><span class="toc__t">{t}</span><Icon name="arrow" size={18} /></a></li>)}
          </ol>
        </nav>
      </div>
      <dl class="ph__meta" data-rv>
        <div><dt class="mono">Para</dt><dd>Andreani Grupo Logístico</dd></div>
        <div><dt class="mono">De</dt><dd>{AUTHOR.name}</dd></div>
        <div><dt class="mono">Fecha</dt><dd>{measured}</dd></div>
        <div><dt class="mono">Alcance</dt><dd>7 páginas navegables</dd></div>
        <div><dt class="mono">Estado</dt><dd>Concepto, no oficial</dd></div>
      </dl>
    </div>
    <Emblem class="ph__em" />
  </section>

  <!-- ============ 01 · CARTA ============ -->
  <section id="carta" class="sec t-light letter">
    <div class="wrap letter__in">
      <p class="kick">01 · Carta</p>
      <div class="letter__body" data-rv>
        <p class="letter__hi">Hola, equipo de Andreani:</p>
        <p>Andreani mueve {stats.envios.toLocaleString('es-AR')} millones de envíos al año, llega a cada rincón del país y cumplió 80 años. El sitio es la puerta de entrada para quien quiere mandar un paquete, y hoy esa puerta tiene escalones: para hacer un envío primero hay que iniciar sesión, en un celular el inicio tarda varios segundos en mostrarse y la red, la planta de Pacheco y la historia casi no aparecen.</p>
        <p>Armé este concepto para mostrar cómo podría sentirse: rápido, claro y con la energía de la marca. Toda la información es real (sucursales, horarios, cifras del reporte 2025), salvo los precios del cotizador, que son una estimación de demostración.</p>
        <p>No es un trabajo encargado ni oficial. Es una propuesta para conversar.</p>
        <p class="letter__sign">— {AUTHOR.name}</p>
      </div>
    </div>
  </section>

  <!-- ============ 02 · ANTES Y DESPUÉS ============ -->
  <section id="antes-despues" class="sec t-dark ba">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">02 · Antes y después</p><Lines class="dsp d2" text="Misma marca.|*Otro ritmo.*" /></div>
        <p class="lede" data-rv>Arrastrá el control para comparar el sitio actual con el rediseño, en la misma pantalla y con la misma página.</p>
      </div>
      <div data-tabs>
        <div class="seg" role="group" aria-label="Página a comparar" data-rv>
          <button type="button" data-tab="ba-home" aria-pressed="true">Inicio</button>
          <button type="button" data-tab="ba-suc" aria-pressed="false">Sucursales</button>
        </div>
        {[
          { id: 'ba-home', o: 'old-home', n: 'new-home', om: 'old-m', nm: 'new-m', what: 'la página de inicio' },
          { id: 'ba-suc', o: 'old-suc', n: 'new-suc', om: 'old-suc-m', nm: 'new-suc-m', what: 'el buscador de sucursales' },
        ].map((c, i) => (
          <div class="cmp" data-cmp data-panel={c.id} hidden={i > 0} data-rv>
            <picture><source media="(max-width: 640px)" srcset={url(`/pitch/${c.om}.avif`)} width="560" height="953" /><img class="cmp__old" src={url(`/pitch/${c.o}.avif`)} srcset={`${url(`/pitch/${c.o}-sm.avif`)} 900w, ${url(`/pitch/${c.o}.avif`)} 1600w`} sizes="(min-width: 1600px) 1480px, 92vw" alt={`Sitio actual: ${c.what}`} width="1600" height="1000" loading="lazy" decoding="async" /></picture>
            <div class="cmp__new"><picture><source media="(max-width: 640px)" srcset={url(`/pitch/${c.nm}.avif`)} width="560" height="953" /><img src={url(`/pitch/${c.n}.avif`)} srcset={`${url(`/pitch/${c.n}-sm.avif`)} 900w, ${url(`/pitch/${c.n}.avif`)} 1600w`} sizes="(min-width: 1600px) 1480px, 92vw" alt={`Rediseño: ${c.what}`} width="1600" height="1000" loading="lazy" decoding="async" /></picture></div>
            <div class="cmp__bar" aria-hidden="true"><span class="cmp__tag cmp__tag--l mono">Actual</span><span class="cmp__tag cmp__tag--r mono">Rediseño</span><span class="cmp__knob"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5" /></svg></span></div>
            <input class="cmp__range" type="range" min="0" max="100" value="50" step="0.5" aria-label={`Comparar ${c.what}: sitio actual a la izquierda, rediseño a la derecha`} />
          </div>
        ))}
      </div>
      <p class="ba__note mono">Capturas del {measured}: escritorio a 1440 × 900 px y celular a 390 × 664 px. El sitio actual pertenece a Andreani Grupo Logístico.</p>
    </div>
  </section>

  <!-- ============ 03 · DÓNDE HAY MARGEN ============ -->
  <section id="margen" class="sec t-white">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">03 · Dónde hay margen</p><Lines class="dsp d2" text="Lo que funciona|*se queda.*" /></div>
        <p class="lede" data-rv>La red, la marca y la confianza ya están. Estas son las oportunidades que encontré y cómo las resuelve el rediseño.</p>
      </div>
      <ol class="gaps">
        <li data-rv>
          <span class="gaps__n dsp">01</span>
          <h3 class="h3">Cotizar y enviar sin cuenta</h3>
          <p class="prose">Hoy “Hacer un envío” lleva directo al inicio de sesión. En el rediseño los precios se ven sin registrarse y el envío se arma completo; los datos se piden recién al final.</p>
        </li>
        <li data-rv style="--d:90">
          <span class="gaps__n dsp">02</span>
          <h3 class="h3">Velocidad en el celular</h3>
          <p class="prose">En un celular con 4G, el contenido principal del inicio tarda {fmt(round(M.home.old.lcp / 1000, 1), 1)} s en aparecer y la página descarga {fmt(round(M.home.old.bytes / 1e6, 1), 1)} MB. El rediseño lo muestra {speedup} veces antes y pesa {lighter} veces menos.</p>
        </li>
        <li data-rv style="--d:180">
          <span class="gaps__n dsp">03</span>
          <h3 class="h3">Accesible para todos</h3>
          <p class="prose">Hoy Lighthouse marca contraste insuficiente, títulos fuera de orden, enlaces sin nombre y botones chicos para tocar. El rediseño los resuelve: el inicio pasa de {M.home.old.a11y} a {M.home.new.a11y} en accesibilidad.</p>
        </li>
        <li data-rv style="--d:270">
          <span class="gaps__n dsp">04</span>
          <h3 class="h3">Una marca con historia</h3>
          <p class="prose">80 años, {stats.envios.toLocaleString('es-AR')} M de envíos y una planta que clasifica {stats.porHora.toLocaleString('es-AR')} paquetes por hora. Hoy esa historia vive lejos del inicio; acá la cuenta el propio sitio.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ 04 · LOS NÚMEROS ============ -->
  <section id="numeros" class="sec t-dark nums">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">04 · Los números</p><Lines class="dsp d2" text="Medido,|*no prometido.*" /></div>
        <p class="lede" data-rv>Misma herramienta, mismas condiciones: {M.tool}. Cada cifra cuenta desde el valor del sitio actual hasta el del rediseño.</p>
      </div>
      <div class="rings">
        {pages.map((p, i) => (
          <figure class="ring" data-rv style={`--d:${i * 120};--off:${100 - p.n.perf};--offo:${100 - p.o.perf}`}>
            <div class="ring__g">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="ring__t" cx="60" cy="60" r="52" pathLength="100" />
                <circle class="ring__v" cx="60" cy="60" r="52" pathLength="100" />
                <circle class="ring__to" cx="60" cy="60" r="40" pathLength="100" />
                <circle class="ring__o" cx="60" cy="60" r="40" pathLength="100" />
              </svg>
              <p class="ring__c"><span class="ring__n" data-count={p.n.perf}>{p.n.perf}</span><small class="mono">de 100</small></p>
            </div>
            <figcaption><strong>{p.label}</strong><span>Rendimiento móvil · actual {p.o.perf}, rediseño {p.n.perf}</span></figcaption>
          </figure>
        ))}
        <div class="rings__legend" data-rv style="--d:240">
          <p class="key"><i class="key__n"></i>Rediseño</p>
          <p class="key"><i class="key__o"></i>Sitio actual</p>
          <p class="rings__big"><span class="dsp">×{speedup}</span> más rápido en mostrar el contenido principal del inicio.</p>
        </div>
      </div>

      <div data-tabs class="ledger-wrap">
        <div class="ledger-top">
          <div class="seg" role="group" aria-label="Página medida">
            {pages.map((p, i) => <button type="button" data-tab={`m-${p.id}`} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>)}
          </div>
          <div class="ledger-key" aria-hidden="true"><span class="key"><i class="key__o"></i>Sitio actual</span><span class="key"><i class="key__n"></i>Rediseño</span></div>
        </div>
        {pages.map((p, i) => (
          <table class="ledger" data-panel={`m-${p.id}`} hidden={i > 0}>
            <caption class="sr-only">{p.label}: sitio actual comparado con el rediseño</caption>
            <thead><tr><th scope="col">Métrica</th><th scope="col">Sitio actual y rediseño</th><th scope="col">Cambio</th></tr></thead>
            <tbody>
              {p.rows.map((r) => {
                const max = r.max ?? Math.max(r.old, r.neu, 0.0001)
                return (
                  <tr>
                    <th scope="row">{r.k}<small>{r.hint}</small></th>
                    <td class="ledger__bars">
                      <div class="b b--o"><i style={`--w:${((r.old / max) * 100).toFixed(1)}`}></i><span><span class="sr-only">Actual: </span>{fmt(round(r.old, r.dec), r.dec)}{r.unit}</span></div>
                      <div class="b b--n"><i style={`--w:${((r.neu / max) * 100).toFixed(1)}`}></i><span><span class="sr-only">Rediseño: </span>{fmt(round(r.neu, r.dec), r.dec)}{r.unit}</span></div>
                    </td>
                    <td class="ledger__d">{change(r)}</td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        ))}
        <p class="ledger__note">Medición del {measured} con Lighthouse sobre el sitio publicado, perfil móvil (Moto G Power, 4G lenta simulada). El rediseño tiene la indexación desactivada a propósito por ser un concepto, por eso no se compara SEO.</p>
      </div>
    </div>
  </section>

  <!-- ============ 05 · EL COTIZADOR ============ -->
  <section id="cotizador" class="sec t-light qx">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">05 · El cotizador</p><Lines class="dsp d2" text="De la ruta|*a la etiqueta.*" /></div>
        <p class="lede" data-rv>La pieza que más vende. Inspirado en los cotizadores instantáneos de la logística digital: precios en segundos, sin registrarse, y la reserva completa en el mismo lugar.</p>
      </div>
      <div class="qx__grid">
        <figure class="qx__shot" data-rv>
          <img src={url('/pitch/quote.avif')} srcset={`${url('/pitch/quote-sm.avif')} 900w, ${url('/pitch/quote.avif')} 1600w`} sizes="(min-width: 1100px) 60vw, 92vw" alt="Cotizador del rediseño con la ruta Rosario a Ushuaia trazada en el mapa y los precios Estándar y Prioritario" width="1600" height="1471" loading="lazy" decoding="async" />
        </figure>
        <ol class="qx__steps">
          {pasos.map(([t, d], i) => (
            <li data-rv style={`--d:${i * 60}`}><span class="qx__n mono">{i + 1}</span><div><b>{t}</b><p>{d}</p></div></li>
          ))}
        </ol>
      </div>
      <ul class="qx__chips" data-rv>
        <li>Localidades reales con autocompletado</li>
        <li>Precios que se recalculan en vivo</li>
        <li>Rutas frecuentes en un toque</li>
        <li>Planilla CSV de hasta 50 bultos</li>
        <li>Peso volumétrico explicado</li>
        <li>Sucursales reales con horario</li>
        <li>QR que abre el seguimiento</li>
      </ul>
      <figure class="qx__label" data-rv>
        <img src={url('/pitch/label.avif')} alt="Etiqueta generada al final de la reserva, con número de envío, código de destino, código de barras y QR" width="1200" height="793" loading="lazy" decoding="async" />
        <figcaption class="mono">La etiqueta del paso 6. El QR abre el seguimiento de ese mismo envío.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ 06 · IDEAS DE DISEÑO ============ -->
  <section id="ideas" class="sec t-dark">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">06 · Ideas de diseño</p><Lines class="dsp d2" text="Cada detalle|*empuja.*" /></div>
        <p class="lede" data-rv>Animación con propósito: cada movimiento cuenta algo de la logística y nada frena la carga.</p>
      </div>
      <ul class="ideas">
        {ideas.map((x, i) => (
          <li data-rv style={`--d:${(i % 3) * 80}`}><span class="ideas__i"><Icon name={x.i} size={26} /></span><h3 class="h3">{x.t}</h3><p class="prose">{x.d}</p></li>
        ))}
      </ul>
      <div class="phones" data-rv>
        <figure><img src={url('/pitch/old-m.avif')} alt="Sitio actual en un celular" width="560" height="953" loading="lazy" decoding="async" /><figcaption class="mono">Actual</figcaption></figure>
        <figure class="phones__new"><img src={url('/pitch/new-m.avif')} alt="Rediseño en un celular" width="560" height="953" loading="lazy" decoding="async" /><figcaption class="mono">Rediseño</figcaption></figure>
        <p class="phones__t">Pensado primero para el celular: videos verticales propios, el panel de seguimiento al alcance del pulgar y un menú que se abre en un círculo rojo.</p>
      </div>
    </div>
  </section>

  <!-- ============ 07 · IMPLEMENTACIÓN ============ -->
  <section id="integracion" class="sec t-white">
    <div class="wrap">
      <div class="shead">
        <div><p class="kick">07 · Cómo se implementa</p><Lines class="dsp d2" text="Sobre lo|*que ya existe.*" /></div>
        <p class="lede" data-rv>Sin cambiar de proveedores. El diseño se monta sobre las herramientas y los datos que Andreani ya usa.</p>
      </div>
      <ol class="impl">
        <li data-rv><span class="mono">Contenidos</span><h3 class="h3">Storyblok, como hoy</h3><p class="prose">El sitio actual carga sus textos e íconos desde Storyblok. Cada sección del rediseño se vuelve un bloque editable para el equipo de marketing.</p></li>
        <li data-rv style="--d:80"><span class="mono">Interfaz</span><h3 class="h3">Next.js o estático</h3><p class="prose">Se puede integrar al Next.js actual o publicarse estático, como este prototipo hecho en Astro: el inicio corre con {fmt(Math.round(M.home.new.js / 1000))} KB de JavaScript.</p></li>
