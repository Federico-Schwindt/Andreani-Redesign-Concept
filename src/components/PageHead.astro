---
import Lines from './Lines.astro'
import { media, url } from '../lib/site'
/** compact: para páginas de tarea (enviar, seguir, sucursales), así la herramienta queda en la primera pantalla */
interface Props { kick: string; title: string; lede?: string; video?: string; crumb: string; compact?: boolean }
const { kick, title, lede, video, crumb, compact = false } = Astro.props
---
<section class:list={["ph t-dark", { "ph--c": compact }]} data-hero>
  {video && (
    <div class="ph__bg" aria-hidden="true">
      <img src={media(`${video}.avif`)} alt="" width="1280" height="715" fetchpriority="high" />
      <video muted loop playsinline preload="none" data-src={media(`${video}.mp4`)}></video>
    </div>
  )}
  <div class="wrap ph__in">
    <nav class="ph__crumbs mono" aria-label="Migas"><a href={url('/')}>Inicio</a><span>/</span><span>{crumb}</span></nav>
    <p class="kick" data-rv>{kick}</p>
    <Lines as="h1" class="dsp d1 ph__t" text={title} />
    {lede && <p class="lede" data-rv style="--d:300">{lede}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; overflow: hidden; isolation: isolate; padding-top: calc(var(--hdr) + clamp(56px, 8vw, 130px)); padding-bottom: clamp(48px, 6vw, 96px); }
  .ph__bg { position: absolute; inset: 0; z-index: -1; }
  .ph__bg img, .ph__bg video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 16, 18, 0.92), rgba(15, 16, 18, 0.55) 60%, rgba(15, 16, 18, 0.35)), linear-gradient(0deg, var(--asfalto), transparent 40%); }
  .ph__crumbs { display: flex; gap: 10px; color: var(--muted); margin-bottom: 26px; }
  .ph__crumbs a:hover { color: #fff; }
  .ph__t { margin-top: 20px; font-size: clamp(3rem, 1rem + 7.4vw, 9.4rem); }
  .ph .lede { margin-top: 26px; color: rgba(244, 242, 238, 0.82); }
  .ph--c { padding-top: calc(var(--hdr) + clamp(28px, 3.4vw, 56px)); padding-bottom: clamp(24px, 3vw, 44px); }
  .ph--c .ph__crumbs { margin-bottom: 16px; }
  .ph--c .ph__t { margin-top: 14px; font-size: clamp(2.6rem, 1rem + 4.4vw, 5.6rem); }
  .ph--c .lede { margin-top: 16px; font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem); max-width: 60ch; }
</style>
