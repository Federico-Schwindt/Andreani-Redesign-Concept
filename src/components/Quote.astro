---
/**
 * Cotizador y reserva en 6 pasos (inspirado en los "rate shops" de logística):
 * bultos + ruta con autocompletado → precios al instante → origen → destino → contacto → pago (demo) → etiqueta con QR.
 * Sucursales reales (API pública de Andreani) y localidades reales (Georef). Precios: estimación de demostración.
 */
import Icon from './Icon.astro'
import Emblem from './Emblem.astro'
import Logo from './Logo.astro'
import { MAP } from '../lib/geo'
import { url, stats, company } from '../lib/site'
interface Props { id?: string }
const { id = 'cotizador' } = Astro.props
const tipos = [
  { k: 'paquete', t: 'Paquetería', i: 'box' },
  { k: 'sobre', t: 'Sobre', i: 'mail' },
  { k: 'vinos', t: 'Vinos', i: 'wine' },
  { k: 'bigger', t: 'Bigger y pallets', i: 'pallet' },
]
const steps = ['Bultos', 'Origen', 'Destino', 'Contacto', 'Pago', 'Etiqueta']
const trust = [
  { i: 'locate', b: 'Seguimiento en vivo', s: 'de la etiqueta a la puerta' },
  { i: 'store', b: `${stats.sucursales} sucursales y ${stats.hop.toLocaleString('es-AR')} HOP`, s: 'para despachar y retirar cerca' },
  { i: 'phone', b: 'Atención humana', s: company.phone },
  { i: 'shield', b: 'Etiqueta en 2 minutos', s: 'sin registrarte para cotizar' },
]
const vb = `-40 -20 ${MAP.w + 80} ${MAP.h + 40}`
---
<div class="qt" data-quote id={id} data-trk={url('/seguimiento/')}>
  <div class="qt__tick">
    <p class="qt__tick-k mono"><i aria-hidden="true"></i>Tarifas de referencia · caja de 5 kg</p>
    <div class="qt__tick-vp"><div class="qt__tick-tr" data-qtick></div></div>
  </div>

  <div class="qt__grid">
    <div class="qt__panel" data-qpanel>
      <ol class="qt__steps" aria-label="Pasos del envío">
        {steps.map((s, i) => (
          <li><button type="button" class="qt__st" data-goto={i} disabled={i > 0} aria-current={i === 0 ? 'step' : undefined}><span class="qt__stn">{i + 1}</span><span class="qt__stt">{s}</span></button></li>
        ))}
      </ol>

      <!-- 1 · Bultos y ruta -->
      <form class="qt__pane is-on" data-pane="0" data-qform novalidate aria-label="Cotizar envío">
        <div class="qt__tabs" role="radiogroup" aria-label="Qué enviás">
          {tipos.map((t, i) => (
            <label class="qt__tab"><input type="radio" name="tipo" value={t.k} checked={i === 0} /><span><Icon name={t.i} size={18} />{t.t}</span></label>
          ))}
        </div>

        <div class="qt__route">
          {['o', 'd'].map((k) => (
            <div class="qt__ac qt__box" data-ac={k}>
              <label class="qt__boxl" for={`${id}-${k}`}>{k === 'o' ? 'Desde' : 'Hasta'}</label>
              <span class="qt__pin" aria-hidden="true"><Icon name="pin" size={18} /></span>
              <input id={`${id}-${k}`} class="qt__in" name={k} role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-${k}-list`} autocomplete="off" placeholder="Localidad o código postal" data-ac-input />
              <ul class="qt__list" id={`${id}-${k}-list`} role="listbox" hidden data-ac-list></ul>
            </div>
          ))}
          <button type="button" class="qt__swap" data-swap aria-label="Invertir origen y destino"><Icon name="arrow" size={18} /></button>
        </div>

        <div class="qt__ship qt__box">
          <div class="qt__shiph">
            <span class="qt__boxl">Bultos</span>
            <div class="qt__unit" role="radiogroup" aria-label="Tipo de bulto" data-qunit hidden>
              <label><input type="radio" name="unit" value="caja" checked /><span><Icon name="box" size={16} />Caja</span></label>
              <label><input type="radio" name="unit" value="pallet" /><span><Icon name="pallet" size={16} />Pallet</span></label>
            </div>
          </div>
          <div class="qt__rows" data-qrows></div>
          <div class="qt__shipf">
            <button type="button" class="qt__add" data-qadd>+ Agregar bulto</button>
            <p class="qt__sum mono" data-qsum aria-live="polite">—</p>
          </div>
          <div data-qbulk>
            <label class="qt__drop" data-qdrop>
              <input type="file" accept=".csv,.tsv,.txt,text/csv" class="sr-only" data-qfile />
              <span class="qt__dropi" aria-hidden="true"><Icon name="doc" size={18} /></span>
              <span class="qt__dropt"><b>¿Muchos bultos? Soltá tu planilla acá o <u>elegí un archivo</u></b><small>CSV con columnas cantidad, kg, largo, ancho y alto. Hasta 50 bultos, cotizados como un solo envío.</small></span>
            </label>
            <button type="button" class="qt__tpl" data-qtpl>Descargar la plantilla</button>
          </div>
        </div>

        <div class="qt__og2">
          <fieldset class="qt__og">
            <legend class="qt__boxl">Despacho</legend>
            <label class="qt__chip"><input type="radio" name="desp" value="sucursal" checked /><span><Icon name="store" size={16} />Lo llevo a sucursal<em>Incluido</em></span></label>
            <label class="qt__chip"><input type="radio" name="desp" value="retiro" /><span><Icon name="truck" size={16} />Retiro a domicilio<em>+ $ 3.900</em></span></label>
          </fieldset>
          <fieldset class="qt__og">
            <legend class="qt__boxl">Entrega</legend>
            <label class="qt__chip"><input type="radio" name="ent" value="domicilio" checked /><span><Icon name="home" size={16} />A domicilio</span></label>
            <label class="qt__chip"><input type="radio" name="ent" value="sucursal" /><span><Icon name="store" size={16} />En sucursal<em>Más barato</em></span></label>
          </fieldset>
        </div>

        <div class="qt__date">
          <span class="qt__boxl">Fecha de despacho</span>
          <b data-qdate>—</b>
          <button type="button" class="qt__chg" data-qdate-btn aria-expanded="false" aria-controls={`${id}-days`}>Cambiar</button>
          <div class="qt__days" id={`${id}-days`} role="radiogroup" aria-label="Fecha de despacho" data-qdays hidden></div>
        </div>

        <button class="qt__cta" type="submit" data-qgo><span data-qgo-t>Ver precios</span><Icon name="arrow" size={20} /></button>
        <p class="qt__micro"><i aria-hidden="true"></i>Sin registrarte. Precios en pesos, con IVA. Estimación de demo.</p>
        <p class="qt__err" role="alert" hidden data-qerr></p>

        <div class="qt__rates" data-qrates>
          <p class="qt__rh" aria-live="polite" data-qrh><i aria-hidden="true"></i><span>Completá origen y destino para ver los precios</span></p>
          <div class="qt__rl" role="radiogroup" aria-label="Servicio">
            {[['std', 'Estándar', 'truck'], ['prio', 'Prioritario', 'bolt']].map(([k, t, ic], i) => (
              <label class="qt__rate" data-rate={k}>
                <input type="radio" name="vel" value={k} checked={i === 0} disabled />
                <span class="qt__ri" aria-hidden="true"><Icon name={ic} size={20} /></span>
                <span class="qt__rt"><b>{t}{k === 'std' && <em>Más elegido</em>}</b><small data-eta={k}>Plazo según la ruta</small></span>
                <span class="qt__rp" data-price={k}>Ingresá la ruta</span>
              </label>
            ))}
          </div>
          <button type="button" class="qt__save" data-qsave hidden></button>
          <button type="button" class="qt__cta qt__cta--go" data-qnext hidden><span>Continuar con <b data-qnext-t>Estándar</b></span><Icon name="arrow" size={20} /></button>
          <p class="qt__fine">Precio todo incluido: recepción o retiro, combustible y entrega. Referencia de demo: el precio final se confirma al pagar.</p>
        </div>
      </form>

      <!-- 2 · Origen -->
      <form class="qt__pane" data-pane="1" novalidate aria-labelledby={`${id}-h1`}>
        <div class="qt__ph">
          <h3 class="qt__h" id={`${id}-h1`} tabindex="-1">¿Desde dónde sale?</h3>
          <button type="button" class="qt__demo" data-fill>Completar con datos de ejemplo</button>
        </div>
        <button type="button" class="qt__place" data-goto="0"><Icon name="pin" size={16} /><span data-qp="o">—</span><u>Cambiar</u></button>
        <div data-mode="sucursal">
          <p class="qt__hint">Elegí dónde lo dejás. Son las sucursales más cercanas a tu origen, con su horario real.</p>
          <div class="qt__sucs" role="radiogroup" aria-label="Sucursal de despacho" data-sucs="o"></div>
        </div>
        <div data-mode="retiro" hidden>
          <p class="qt__hint">Pasamos a buscarlo <b data-qdate2>—</b>, entre las 9 y las 18 h.</p>
          <div class="qt__fields">
            <label class="qt__fld qt__fld--w"><span>Calle y número</span><input name="calle" autocomplete="address-line1" placeholder="Av. Pellegrini 1250" data-req /></label>
            <label class="qt__fld"><span>Piso / depto</span><input name="piso" autocomplete="address-line2" placeholder="Opcional" /></label>
            <label class="qt__fld"><span>Código postal</span><input name="cp" inputmode="numeric" autocomplete="postal-code" placeholder="2000" /></label>
          </div>
        </div>
        <p class="qt__err" role="alert" hidden data-perr></p>
        <div class="qt__nav"><button type="button" class="qt__back" data-back><Icon name="back" size={16} />Volver</button><button class="qt__cta qt__cta--sm" type="submit"><span>Continuar</span><Icon name="arrow" size={18} /></button></div>
      </form>

      <!-- 3 · Destino -->
      <form class="qt__pane" data-pane="2" novalidate aria-labelledby={`${id}-h2`}>
        <div class="qt__ph">
          <h3 class="qt__h" id={`${id}-h2`} tabindex="-1">¿Quién lo recibe?</h3>
          <button type="button" class="qt__demo" data-fill>Completar con datos de ejemplo</button>
        </div>
        <button type="button" class="qt__place" data-goto="0"><Icon name="pin" size={16} /><span data-qp="d">—</span><u>Cambiar</u></button>
        <div class="qt__fields">
          <label class="qt__fld qt__fld--w"><span>Nombre y apellido</span><input name="nombre" autocomplete="name" placeholder="Lucía Fernández" data-req /></label>
        </div>
        <div data-mode="domicilio">
          <div class="qt__fields">
            <label class="qt__fld qt__fld--w"><span>Calle y número</span><input name="calle" autocomplete="address-line1" placeholder="San Martín 455" data-req /></label>
            <label class="qt__fld"><span>Piso / depto</span><input name="piso" autocomplete="address-line2" placeholder="Opcional" /></label>
            <label class="qt__fld"><span>Código postal</span><input name="cp" inputmode="numeric" autocomplete="postal-code" placeholder="9410" /></label>
          </div>
        </div>
        <div data-mode="sucursal" hidden>
          <p class="qt__hint">¿En qué sucursal lo retira? Le avisamos apenas llega.</p>
          <div class="qt__sucs" role="radiogroup" aria-label="Sucursal de retiro" data-sucs="d"></div>
        </div>
        <p class="qt__err" role="alert" hidden data-perr></p>
        <div class="qt__nav"><button type="button" class="qt__back" data-back><Icon name="back" size={16} />Volver</button><button class="qt__cta qt__cta--sm" type="submit"><span>Continuar</span><Icon name="arrow" size={18} /></button></div>
      </form>

      <!-- 4 · Contacto -->
      <form class="qt__pane" data-pane="3" novalidate aria-labelledby={`${id}-h3`}>
        <div class="qt__ph">
          <h3 class="qt__h" id={`${id}-h3`} tabindex="-1">¿A dónde te avisamos?</h3>
          <button type="button" class="qt__demo" data-fill>Completar con datos de ejemplo</button>
        </div>
        <div class="qt__fields">
          <label class="qt__fld qt__fld--w"><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="vos@ejemplo.com" data-req /></label>
          <label class="qt__fld qt__fld--w"><span>Celular (opcional)</span><input name="cel" type="tel" autocomplete="tel" placeholder="11 5555 5555" /></label>
        </div>
        <label class="qt__check"><input type="checkbox" name="wa" checked /><span>Avisarle al destinatario por WhatsApp cuando salga a reparto</span></label>
        <p class="qt__note mono">Demo: nada de lo que escribas sale de tu navegador.</p>
        <p class="qt__err" role="alert" hidden data-perr></p>
        <div class="qt__nav"><button type="button" class="qt__back" data-back><Icon name="back" size={16} />Volver</button><button class="qt__cta qt__cta--sm" type="submit"><span>Ir al pago</span><Icon name="arrow" size={18} /></button></div>
      </form>

      <!-- 5 · Pago -->
      <form class="qt__pane" data-pane="4" novalidate aria-labelledby={`${id}-h4`}>
        <div class="qt__ph"><h3 class="qt__h" id={`${id}-h4`} tabindex="-1">Revisá y pagá</h3></div>
        <dl class="qt__bill" data-qbill></dl>
        <div class="qt__total"><span>Total</span><b data-qtotal>—</b></div>
        <fieldset class="qt__og qt__og--pay">
          <legend class="qt__boxl">Medio de pago</legend>
          <label class="qt__chip"><input type="radio" name="pago" value="tarjeta" checked /><span>Tarjeta de crédito o débito</span></label>
          <label class="qt__chip"><input type="radio" name="pago" value="cuenta" /><span>Dinero en cuenta</span></label>
          <label class="qt__chip"><input type="radio" name="pago" value="cc" /><span>Cuenta corriente (empresas)</span></label>
        </fieldset>
        <p class="qt__note mono">En esta demo no se pide ni se procesa ningún dato de pago. En el sitio real, acá se abre el checkout seguro.</p>
        <div class="qt__nav"><button type="button" class="qt__back" data-back><Icon name="back" size={16} />Volver</button><button class="qt__cta qt__cta--sm" type="submit" data-qpay><span>Pagar <b data-qpay-t>—</b></span><Icon name="arrow" size={18} /></button></div>
      </form>

      <!-- 6 · Etiqueta -->
      <div class="qt__pane" data-pane="5" role="group" aria-labelledby={`${id}-h5`}>
        <div class="qt__ph"><h3 class="qt__h" id={`${id}-h5`} tabindex="-1">¡Listo! Tu etiqueta</h3><span class="qt__ok mono"><Icon name="check" size={14} />Envío creado</span></div>
        <div class="qt__printer">
          <div class="qt__slot" aria-hidden="true"></div>
          <article class="label qt__lbl" data-qlbl>
            <header class="qt__lh"><Logo class="qt__lbl-logo" /><span class="qt__lsvc" data-l="svc">Estándar</span></header>
            <div class="qt__lg">
              <div><span class="mono">Remitente</span><b data-l="from">—</b><small data-l="froma">—</small></div>
              <div><span class="mono">Destinatario</span><b data-l="to">—</b><small data-l="toa">—</small></div>
            </div>
            <div class="qt__lm">
              <div class="qt__qr" data-l="qr" aria-label="Código QR para seguir el envío" role="img"></div>
              <div class="qt__lmi">
                <span class="mono">N.º de envío</span>
                <b class="qt__ln" data-l="n">—</b>
                <span class="qt__lcode" data-l="code">—</span>
                <span class="mono" data-l="meta">—</span>
              </div>
            </div>
            <div class="barcode qt__lbc" aria-hidden="true"></div>
            <p class="qt__lf mono">Escaneá el QR para seguirlo · Concepto: no válida para despachar</p>
          </article>
        </div>
        <div class="qt__done">
          <a class="qt__cta qt__cta--sm" data-l="track" href={url('/seguimiento/')}><span>Seguir este envío</span><Icon name="arrow" size={18} /></a>
          <button type="button" class="qt__back" data-qpdf>Descargar PDF</button>
          <button type="button" class="qt__back" data-qnew>Hacer otro envío</button>
        </div>
      </div>
    </div>

    <div class="qt__stage" data-qstage>
      <svg class="qt__map" viewBox={vb} preserveAspectRatio="xMaxYMid meet" aria-hidden="true" data-qsvg>
        <use href="#ar-provs" class="qt__provs" />
        <g class="qt__lanes" data-qlanes></g>
        <path class="qt__arc qt__arc--glow" d="" data-qarc2 />
        <path class="qt__arc" d="" data-qarc />
        <g class="qt__cands" data-qcands></g>
        <g class="qt__mk qt__mk--o" data-mk="o"><circle r="26" class="qt__ring" /><circle r="9" /></g>
        <g class="qt__mk qt__mk--d" data-mk="d"><circle r="26" class="qt__ring" /><circle r="9" /></g>
        <g class="qt__van" data-qvan><rect x="-16" y="-10" width="32" height="20" rx="5" /><circle r="3" cx="-8" cy="11" /><circle r="3" cx="9" cy="11" /></g>
      </svg>
      <p class="qt__live mono" data-qlive><i aria-hidden="true"></i><span>Mapa en vivo</span></p>

      <div class="qbox" data-qbox aria-hidden="true">
        <div class="qbox__c">
          <i class="qf qf--front"><span class="qf__tape"></span><span class="qf__lbl"><b>AND</b><span class="barcode"></span></span></i>
          <i class="qf qf--back"><span class="qf__tape"></span></i>
          <i class="qf qf--right"><Emblem class="qf__em" /></i>
          <i class="qf qf--left"></i>
          <i class="qf qf--top"><span class="qf__tape qf__tape--top"></span></i>
          <i class="qf qf--bottom"></i>
        </div>
        <span class="qbox__n mono" data-qn>× 1</span>
      </div>

      <div class="qt__top" data-qtop>
        <p class="qt__boxl">Rutas más cotizadas</p>
        <ul data-qtoplist></ul>
        <p class="qt__toph">Tocá una ruta: se completa sola y cotiza al instante.</p>
      </div>

      <div class="qt__hud">
        <p class="mono" data-qroute>Elegí origen y destino</p>
        <p class="mono qt__vw" data-qvw>—</p>
      </div>
    </div>
  </div>

  <ul class="qt__trust">
    {trust.map((t) => (<li><span class="qt__ti"><Icon name={t.i} size={18} /></span><span><b>{t.b}</b><small>{t.s}</small></span></li>))}
  </ul>
  <div class="qt__toast" role="status" data-qtoast hidden></div>
</div>

<style is:global>
  .qt { scroll-margin-top: 96px; --qb: #1c1d21; --qb2: #24262b; --ql: rgba(255, 255, 255, 0.09); position: relative; display: grid; gap: 12px; padding: 12px; border-radius: 34px; background: var(--asfalto-2); color: var(--hueso); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 60px 120px -60px rgba(0, 0, 0, 0.8); }
  .qt .mono { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; }

  /* ticker */
  .qt__tick { display: flex; align-items: center; gap: 14px; min-width: 0; padding: 4px 6px 4px 16px; border-radius: 22px; background: #121316; box-shadow: inset 0 0 0 1px var(--ql); overflow: hidden; }
  .qt__tick-k { flex: none; display: flex; align-items: center; gap: 8px; color: var(--brasa); }
  .qt__tick-k i, .qt__micro i, .qt__rh i, .qt__live i { width: 7px; height: 7px; border-radius: 50%; background: var(--brasa); box-shadow: 0 0 0 0 rgba(255, 77, 61, 0.6); animation: qt-dot 1.8s infinite; flex: none; }
  @keyframes qt-dot { 70% { box-shadow: 0 0 0 7px rgba(255, 77, 61, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 77, 61, 0); } }
  .qt__tick-vp { flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .qt__tick-g { display: flex; }
  .qt__tick-tr { display: flex; width: max-content; animation: qt-tick 60s linear infinite; }
  .qt__tick:hover .qt__tick-tr, .qt__tick:focus-within .qt__tick-tr { animation-play-state: paused; }
  @keyframes qt-tick { to { transform: translateX(-50%); } }
  .qt__lane { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-right: 1px solid var(--ql); font-size: 0.84rem; white-space: nowrap; color: rgba(244, 242, 238, 0.82); transition: color 0.2s, background-color 0.2s; border-radius: 12px; }
  .qt__lane b { color: #fff; font-weight: 750; }
  .qt__lane span { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brasa); }
  .qt__lane:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }

  .qt__grid { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr); gap: 12px; align-items: stretch; }
  .qt__panel { min-width: 0; padding: clamp(14px, 1.8vw, 24px); border-radius: 26px; background: #121316; box-shadow: inset 0 0 0 1px var(--ql); }

  /* stepper */
  .qt__steps { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 18px; }
  .qt__st { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px 0 5px; border-radius: 99px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); color: rgba(244, 242, 238, 0.6); font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; transition: background-color 0.3s, color 0.3s, box-shadow 0.3s; }
  .qt__stn { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--qb2); color: #fff; font-size: 0.66rem; transition: background-color 0.3s; }
  .qt__st:not(:disabled):hover { color: #fff; }
  .qt__st[aria-current='step'] { color: #fff; box-shadow: inset 0 0 0 1.5px var(--brasa); background: rgba(215, 25, 32, 0.12); }
  .qt__st[aria-current='step'] .qt__stn { background: var(--rojo); }
  .qt__st.done { color: rgba(244, 242, 238, 0.85); }
  .qt__st.done .qt__stn { background: #fff; color: var(--rojo); font-size: 0; }
  .qt__st.done .qt__stn::before { content: '✓'; font-size: 0.8rem; font-weight: 700; }
  .qt__st:disabled { cursor: default; opacity: 0.55; }
  .qt__st.done:disabled, .qt__st[aria-current='step']:disabled { opacity: 1; }

  /* panes */
  .qt__pane { display: none; gap: 12px; }
  .qt__pane.is-on { display: grid; }
  .qt__box { position: relative; border-radius: 18px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); transition: box-shadow 0.25s; }
  .qt__boxl { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(244, 242, 238, 0.55); }

  /* tabs */
  .qt__tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 18px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); }
