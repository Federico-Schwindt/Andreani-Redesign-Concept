  .qr__f:focus-within { box-shadow: inset 0 0 0 2px var(--rojo); }
  .qr__f > span { font-family: var(--mono); font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(244, 242, 238, 0.5); white-space: nowrap; }
  .qr__f input, .qr__f select { width: 100%; min-width: 0; border: 0; background: none; color: #fff; text-align: center; font-size: 1.05rem; font-weight: 650; font-variant-numeric: tabular-nums; outline: none; -moz-appearance: textfield; appearance: none; text-align-last: center; }
  .qr__f select { cursor: pointer; font-size: 0.95rem; }
