  .qt__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .qt__fld { display: grid; gap: 2px; padding: 10px 14px; border-radius: 15px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); cursor: text; transition: box-shadow 0.2s; }
