  .qt__tab input:focus-visible + span, .qt__unit input:focus-visible + span, .qt__chip input:focus-visible + span, .qt__rate input:focus-visible ~ .qt__rt, .qt__suc input:focus-visible + span, .qt__day input:focus-visible + span { outline: 2px solid var(--brasa); outline-offset: 2px; }

