  .qt__cta--go { margin-top: 2px; }
  .qt__cta.is-busy span::after { content: ''; display: inline-block; width: 14px; height: 14px; margin-left: 10px; vertical-align: -2px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.4); border-top-color: #fff; animation: qt-spin 0.7s linear infinite; }
  @keyframes qt-spin { to { transform: rotate(360deg); } }
  .qt__micro { display: flex; align-items: center; gap: 8px; margin: -2px 0 0; font-size: 0.78rem; color: rgba(244, 242, 238, 0.55); }
