  .qt__place { justify-self: start; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 0; border-radius: 12px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); color: #fff; font-size: 0.9rem; font-weight: 600; }
