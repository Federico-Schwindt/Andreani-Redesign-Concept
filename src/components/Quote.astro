  .qt__drop { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; border: 1.5px dashed rgba(255, 77, 61, 0.35); background: rgba(215, 25, 32, 0.04); cursor: pointer; transition: background-color 0.25s, border-color 0.25s; }
  .qt__drop:hover, .qt__drop.over { background: rgba(215, 25, 32, 0.12); border-color: var(--brasa); }
