  .qt__swap:hover { transform: rotate(180deg); background: var(--rojo); color: #fff; }
  .qt__list { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 30; list-style: none; padding: 6px; margin: 0; border-radius: 16px; background: #fff; color: var(--asfalto); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7); max-height: 280px; overflow-y: auto; }
  .qt__list li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; font-size: 0.95rem; }
  .qt__list li small { color: rgba(15, 16, 18, 0.55); font-size: 0.8rem; white-space: nowrap; }
  .qt__list li[aria-selected='true'], .qt__list li:hover { background: var(--hueso); }

  /* bultos */
  .qt__ship { padding: 12px; display: grid; gap: 10px; }
  .qt__shiph { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 30px; padding-left: 4px; }
  .qt__unit { display: flex; gap: 2px; padding: 3px; border-radius: 12px; background: #121316; }
  .qt__unit[hidden] { display: none; }
  .qt__unit span { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 9px; font-size: 0.82rem; font-weight: 600; color: rgba(244, 242, 238, 0.6); cursor: pointer; transition: background-color 0.25s, color 0.25s; }
  .qt__unit input:checked + span { background: var(--qb2); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14); }
  .qt__rows { display: grid; gap: 8px; max-height: 330px; overflow-y: auto; overscroll-behavior: contain; padding: 2px; margin: -2px; }
  .qr { display: grid; grid-template-columns: 0.8fr 1fr repeat(3, minmax(0, 0.8fr)) 30px; gap: 6px; align-items: stretch; animation: qr-in 0.45s var(--ease) both; }
