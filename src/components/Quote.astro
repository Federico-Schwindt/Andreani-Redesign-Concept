  /* CTA */
  .qt__cta { --b: var(--rojo); position: relative; display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; height: 62px; padding: 0 24px; border: 0; border-radius: 18px; background: var(--b); color: #fff; font-weight: 750; font-stretch: 110%; font-size: 1.06rem; text-decoration: none; overflow: hidden; isolation: isolate; box-shadow: 0 18px 40px -18px rgba(215, 25, 32, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.18); transition: transform 0.35s var(--ease), box-shadow 0.35s; }
  .qt__cta::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.28) 50%, transparent 70%); transform: translateX(-110%); transition: transform 0.8s var(--ease); }
  .qt__cta:hover { transform: translateY(-2px); box-shadow: 0 24px 50px -18px rgba(215, 25, 32, 1), inset 0 1px 0 rgba(255, 255, 255, 0.2); }
  .qt__cta:hover::before { transform: translateX(110%); }
  .qt__cta svg { transition: transform 0.35s var(--ease); }
  .qt__cta:hover svg { transform: translateX(4px); }
  .qt__cta:disabled { opacity: 0.6; cursor: progress; transform: none; }
