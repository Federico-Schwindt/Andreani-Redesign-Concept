  .qt__day span { display: grid; justify-items: center; gap: 1px; min-width: 62px; padding: 8px 6px; border-radius: 12px; background: #121316; box-shadow: inset 0 0 0 1px var(--ql); font-size: 0.72rem; color: rgba(244, 242, 238, 0.6); text-transform: capitalize; cursor: pointer; transition: box-shadow 0.2s, color 0.2s; }
