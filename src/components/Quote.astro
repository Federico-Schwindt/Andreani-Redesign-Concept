  .qt__rates.is-ready .qt__rh i { background: #35d07f; animation: qt-dot 1.8s infinite; box-shadow: none; }
  .qt__rl { display: grid; gap: 8px; }
  .qt__rate { position: relative; display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 14px; min-height: 72px; padding: 12px 18px 12px 14px; border-radius: 18px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); cursor: default; overflow: hidden; transition: box-shadow 0.3s, background-color 0.3s, transform 0.4s var(--ease); }
  .qt__rates.is-ready .qt__rate { cursor: pointer; }
