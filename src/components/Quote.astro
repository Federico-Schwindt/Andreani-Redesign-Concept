  .qt__tpl { margin: 6px 0 0 4px; padding: 0; border: 0; background: none; color: rgba(244, 242, 238, 0.65); font-size: 0.78rem; text-decoration: underline; text-underline-offset: 3px; }
  .qt__tpl:hover { color: #fff; }
  [data-qbulk][hidden] { display: none; }

  /* opciones */
  .qt__og2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .qt__og { display: grid; gap: 6px; min-width: 0; margin: 0; padding: 10px; border: 0; border-radius: 18px; background: var(--qb); box-shadow: inset 0 0 0 1px var(--ql); }
