  @keyframes qt-shake { 25% { transform: translateX(-6px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-3px); } }
  .qt__pin { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: rgba(244, 242, 238, 0.4); transition: color 0.3s; }
  .qt__in { display: block; width: 100%; height: 30px; margin-top: 2px; padding: 0; border: 0; background: none; color: #fff; font-size: 1.08rem; font-weight: 600; outline: none; text-overflow: ellipsis; }
